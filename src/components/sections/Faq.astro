---
/**
 * FAQ: native <details>, so it works without JS and every answer is in the HTML. Where the browser
 * supports animating to `auto` (interpolate-size + ::details-content), opening slides; elsewhere it
 * simply opens. Also emits FAQPage structured data.
 */
import type { Copy } from '../../content/types'

interface Props {
  copy: Copy
}

const { copy } = Astro.props
const faq = copy.faq
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
}
---

<section id="faq" class="section faq" aria-labelledby="faq-title">
  <div class="container layout">
    <h2 id="faq-title" class="title">
      {faq.title}
    </h2>
    <div class="list">
      {faq.items.map((item) => (
        <details class="item">
          <summary class="q">
            <span>{item.q}</span>
            <span class="sign" aria-hidden="true" />
          </summary>
          <p class="a">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-6) clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .title {
    position: sticky;
    top: calc(var(--header-h) + var(--space-6));
    font-size: var(--fs-2xl);
  }

  .item {
    border-top: 1px solid var(--line);
  }
  .item:last-child {
    border-bottom: 1px solid var(--line);
  }
  .q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: 1.3;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .q::-webkit-details-marker {
    display: none;
  }
  .q:hover {
    color: var(--accent);
  }
  .q:focus-visible {
    outline-offset: 4px;
  }

  /* A plus that turns into a minus. */
  .sign {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line2);
    border-radius: 7px;
  }
  .sign::before,
  .sign::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform var(--dur) var(--ease-out);
  }
  .sign::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .item[open] .sign::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .item[open] .sign {
    border-color: var(--accent);
    color: var(--accent);
  }

  .a {
    max-width: 68ch;
    padding: 0 48px 22px 0;
    color: var(--dim);
  }

  /* Progressive enhancement: slide open where `auto` can be animated. */
  @supports (interpolate-size: allow-keywords) {
    .item {
      interpolate-size: allow-keywords;
    }
    .item::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size var(--dur) var(--ease-out),
        content-visibility var(--dur) allow-discrete;
    }
    .item[open]::details-content {
      block-size: auto;
    }
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .title {
      position: static;
    }
    .a {
      padding-right: 0;
    }
  }
</style>
