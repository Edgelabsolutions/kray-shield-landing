---
/**
 * The "How it works" diagram: five places and the links between them. Which nodes and links light
 * up is pure CSS, keyed on `data-active-step` on the root; the moving chips (Share A, Share B, the
 * key) are positioned by the section's script (GSAP), with their SSR position being step 1's end.
 *
 * Geometry is in a 560×460 viewBox. Chips are drawn centred on their own origin so the script can
 * move them with a plain translate.
 */
import { Cloud, Drone, LayoutDashboard, Smartphone, Usb } from 'lucide-react'
import type { Copy } from '../../content/types'

interface Props {
  d: Copy['how']['diagram']
}

const { d } = Astro.props

type NodeKey = 'bench' | 'cloud' | 'console' | 'drone' | 'phone'
const NODES: Record<
  NodeKey,
  { x: number; y: number; w: number; h: number; steps: string; label: string; short: string }
> = {
  bench: { x: 20, y: 20, w: 210, h: 84, steps: '1', label: d.bench, short: d.short.bench },
  cloud: { x: 330, y: 20, w: 210, h: 84, steps: '1 2', label: d.cloud, short: d.short.cloud },
  console: {
    x: 330,
    y: 160,
    w: 150,
    h: 52,
    steps: '2',
    label: d.console,
    short: d.short.console,
  },
  drone: { x: 20, y: 352, w: 210, h: 92, steps: '1 3', label: d.drone, short: d.short.drone },
  phone: { x: 330, y: 352, w: 210, h: 92, steps: '2 3', label: d.phone, short: d.short.phone },
}
const ICONS = {
  bench: Usb,
  cloud: Cloud,
  console: LayoutDashboard,
  drone: Drone,
  phone: Smartphone,
}
---

<svg
  class="diagram"
  viewBox="0 0 560 460"
  role="img"
  aria-label={d.label}
  data-diagram
  data-active-step="1"
>
  <!-- Links (drawn first so nodes sit on top). -->
  <g class="links" fill="none">
    <line class="link" data-steps="1" x1="125" y1="104" x2="125" y2="352"></line>
    <line class="link" data-steps="1" x1="230" y1="82" x2="330" y2="82"></line>
    <line class="link link--admin" data-steps="2" x1="405" y1="160" x2="405" y2="104"></line>
    <line class="link" data-steps="2" x1="500" y1="104" x2="500" y2="352"></line>
    <line class="link" data-steps="3" x1="330" y1="418" x2="230" y2="418"></line>
  </g>
  <g class="link-labels">
    <text x="135" y="232" data-steps="1">
      {d.usb}
    </text>
    <text x="280" y="72" text-anchor="middle" data-steps="1">
      {d.tls}
    </text>
    <text x="490" y="286" text-anchor="end" data-steps="2">
      {d.tls}
    </text>
    <text x="280" y="408" text-anchor="middle" class="small long" data-steps="3">
      {d.hotspot}
    </text>
    <text x="280" y="404" text-anchor="middle" class="short" data-steps="3">
      {d.short.hotspot}
    </text>
  </g>

  <!-- Nodes. -->
  {(Object.keys(NODES) as NodeKey[]).map((key) => {
    const n = NODES[key]
    const Icon = ICONS[key]
    return (
      <g class={`node node--${key}`} data-steps={n.steps}>
        <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="10" />
        <Icon
          x={n.x + 14}
          y={n.y + 15}
          width={20}
          height={20}
          strokeWidth={1.75}
          className="node-icon"
        />
        <text x={n.x + 44} y={n.y + 31} class="node-label long">
          {n.label}
        </text>
        <text x={n.x + 42} y={n.y + 33} class="node-label short" aria-hidden="true">
          {n.short}
        </text>
      </g>
    )
  })}

  <!-- Chips: Share A stays on the drone; Share B travels; the key and the open disk appear last. -->
  <g class="chip chip--a" data-chip="a" transform="translate(85 418)">
    <rect x="-15" y="-11" width="30" height="22" rx="5"></rect>
    <text y="4" text-anchor="middle">
      {d.shareA}
    </text>
  </g>
  <g class="chip chip--b" data-chip="b" transform="translate(470 82)">
    <rect x="-15" y="-11" width="30" height="22" rx="5"></rect>
    <text y="4" text-anchor="middle">
      {d.shareB}
    </text>
  </g>
  <g class="chip chip--key" data-chip="key" transform="translate(125 418)" opacity="0">
    <rect x="-62" y="-11" width="124" height="22" rx="5"></rect>
    <text y="4" text-anchor="middle">
      {d.key}
    </text>
  </g>
  <g class="chip chip--disk" data-chip="disk" transform="translate(125 418)" opacity="0">
    <rect x="-62" y="-11" width="124" height="22" rx="5"></rect>
    <text y="4" text-anchor="middle">
      {d.disk}
    </text>
  </g>
</svg>

<style>
  .diagram {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* ---------------------------------------------------------------- links */
  .link {
    stroke: var(--line2);
    stroke-width: 1.5;
    stroke-dasharray: 3 6;
    transition: stroke var(--dur) var(--ease-out);
  }
  .link-labels text {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    fill: var(--dim);
    opacity: 0.55;
    transition: opacity var(--dur) var(--ease-out);
  }
  .link-labels text.small {
    font-size: 10px;
  }

  /* ---------------------------------------------------------------- nodes */
  .node rect {
    fill: var(--panel);
    stroke: var(--line);
    stroke-width: 1;
    transition:
      stroke var(--dur) var(--ease-out),
      fill var(--dur) var(--ease-out);
  }
  .node :global(.node-icon) {
    color: var(--dim);
    transition: color var(--dur) var(--ease-out);
  }
  .node-label {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    fill: var(--dim);
    transition: fill var(--dur) var(--ease-out);
  }
  .node {
    opacity: 0.55;
    transition: opacity var(--dur) var(--ease-out);
  }

  /* Active step: its nodes, links and labels come forward. */
  [data-active-step='1'] [data-steps~='1'],
  [data-active-step='2'] [data-steps~='2'],
  [data-active-step='3'] [data-steps~='3'] {
    opacity: 1;
  }
  [data-active-step='1'] .node[data-steps~='1'] rect,
  [data-active-step='2'] .node[data-steps~='2'] rect,
  [data-active-step='3'] .node[data-steps~='3'] rect {
    stroke: color-mix(in srgb, var(--accent) 60%, transparent);
    fill: color-mix(in srgb, var(--accent) 6%, var(--panel));
  }
  [data-active-step='1'] .node[data-steps~='1'] .node-label,
  [data-active-step='2'] .node[data-steps~='2'] .node-label,
  [data-active-step='3'] .node[data-steps~='3'] .node-label {
    fill: var(--text);
  }
  [data-active-step='1'] .node[data-steps~='1'] :global(.node-icon),
  [data-active-step='2'] .node[data-steps~='2'] :global(.node-icon),
  [data-active-step='3'] .node[data-steps~='3'] :global(.node-icon) {
    color: var(--accent);
  }
  [data-active-step='1'] .link[data-steps~='1'],
  [data-active-step='2'] .link[data-steps~='2'],
  [data-active-step='3'] .link[data-steps~='3'] {
    stroke: var(--accent);
    animation: flow 900ms linear infinite;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -18;
    }
  }

  /* Long labels by default; on narrow screens (where the SVG is ~60% scale) the short ones, larger. */
  .short {
    display: none;
  }
  @media (max-width: 600px) {
    .long {
      display: none;
    }
    .short {
      display: inline;
    }
    .node-label {
      font-size: 24px;
    }
    .link-labels text {
      font-size: 17px;
    }
    .chip text {
      font-size: 17px;
    }
    .chip--key text,
    .chip--disk text {
      font-size: 14px;
    }
  }

  /* ---------------------------------------------------------------- chips */
  .chip rect {
    stroke-width: 1.25;
  }
  .chip text {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .chip--a rect {
    fill: color-mix(in srgb, var(--brand) 22%, var(--panel2));
    stroke: var(--brand);
  }
  .chip--a text {
    fill: var(--text);
  }
  .chip--b rect {
    fill: color-mix(in srgb, var(--accent) 16%, var(--panel2));
    stroke: var(--accent);
  }
  .chip--b text {
    fill: var(--accent);
  }
  .chip--key rect {
    fill: color-mix(in srgb, var(--info) 14%, var(--panel2));
    stroke: var(--info);
  }
  .chip--key text {
    fill: var(--info);
    font-size: 11px;
  }
  .chip--disk rect {
    fill: color-mix(in srgb, var(--ok) 16%, var(--panel2));
    stroke: var(--ok);
  }
  .chip--disk text {
    fill: var(--ok);
    font-size: 11px;
  }
</style>
