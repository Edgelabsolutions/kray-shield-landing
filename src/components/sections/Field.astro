---
/** In the field: the operator app demo beside the facts an operator cares about. */
import SectionIntro from '../SectionIntro.astro'
import PhoneDemo from '../islands/PhoneDemo.tsx'
import type { Copy } from '../../content/types'

interface Props {
  copy: Copy
}

const { copy } = Astro.props
const f = copy.field
---

<section id="field" class="section field" aria-labelledby="field-title">
  <div class="container">
    <SectionIntro id="field-title" title={f.title} lead={f.lead} />
    <div class="layout">
      <div class="phone">
        <PhoneDemo client:visible copy={f.phone} />
      </div>
      <dl class="facts">
        {f.facts.map((fact) => (
          <div class="fact">
            <dt class="fact-title">{fact.title}</dt>
            <dd class="fact-body">{fact.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(300px, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-6);
    margin: 0;
  }
  .fact {
    padding: var(--space-5) 0 var(--space-6);
    border-top: 1px solid var(--line);
  }
  .fact-title {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: 1.2;
  }
  .fact-body {
    margin: var(--space-2) 0 0;
    font-size: var(--fs-base);
    line-height: 1.55;
    color: var(--dim);
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
